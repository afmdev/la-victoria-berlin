    "author": "Angie Izaguirre",
    "google_reviewer_level": "Local Guide Level 2",
    "reviewer_image_link": "https://lh3.googleusercontent.com/a-/ALV-UjVbREclMiNCavKpOb28FWd8PZwAPSgbC0DKyX0L14IAsh9GAt5Kcg=w72-h72-p-rp-mo-ba2-br100",
