/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=31536000, immutable

# images last so this wins over /assets/* — shorter, non-immutable TTL
# lets re-optimized images at the same path self-heal at the edge within 7d
/assets/images/*
  Cache-Control: public, max-age=604800
